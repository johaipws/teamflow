PORT=5000
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_NAME=teamflow
DB_USER=root
DB_PASSWORD=
JWT_SECRET=replace-with-a-long-random-secret
SEED_LEAD_NAME=Team Lead
SEED_LEAD_EMAIL=lead@example.com
SEED_LEAD_PASSWORD=replace-with-a-secure-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=TeamFlow <notifications@example.com>
# EmailJS is preferred when these values are configured.
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=public-key-from-emailjs
# Optional when private-key authorization is enabled in EmailJS.
EMAILJS_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional: set fixed VAPID keys. When omitted, local keys are generated automatically.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
